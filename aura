--======================= CAU HINH =======================--
local HAT_NAME    = "RockAccessory"
local RADIUS      = 10
local HEIGHT      = 0
local SPEED       = 400
local SPIN        = 10
local BOB         = 0.5

local TP_INTERVAL = 0.5
local TP_STAY     = 0.1
local TP_OFFSET   = Vector3.new(0, 0, 0)
local TOGGLE_KEY  = Enum.KeyCode.V
local MAX_DIST    = 60    -- hat xa hon so nay -> snap ve dau
--========================================================--

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer      = Players.LocalPlayer

local TAU       = math.pi * 2
local conn      = nil
local guardConn = nil
local bindToken = 0
local tpOn      = true

local function isJoint(c)
    return c:IsA("Weld") or c:IsA("ManualWeld") or c:IsA("Motor6D")
        or c:IsA("Motor") or c:IsA("WeldConstraint")
end

local function findHat(char)
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Accessory") and child.Name == HAT_NAME then
            local handle = child:FindFirstChild("Handle")
                        or child:FindFirstChildWhichIsA("BasePart")
            if handle then
                return child, handle
            end
        end
    end
    return nil
end

local function setupWeld(handle, head)
    for _, c in ipairs(handle:GetChildren()) do
        if isJoint(c) then
            pcall(function() c:Destroy() end)
        end
    end

    handle.Anchored   = false
    handle.CanCollide = false
    handle.CanTouch   = false
    handle.CanQuery   = false
    handle.Massless   = true

    if handle.Parent then
        for _, p in ipairs(handle.Parent:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                p.Massless   = true
            end
        end
    end

    local w = Instance.new("Weld")
    w.Name   = "AuraWeld"
    w.Part0  = head
    w.Part1  = handle
    w.C0     = CFrame.new(0, 1.5, 0)
    w.C1     = CFrame.new()
    w.Parent = handle

    -- engine tao lai weld goc -> xoa ngay
    if guardConn then guardConn:Disconnect() end
    guardConn = handle.ChildAdded:Connect(function(c)
        if c ~= w and isJoint(c) then
            task.defer(function()
                pcall(function() c:Destroy() end)
            end)
        end
    end)

    return w
end

local function bind(char)
    if conn then conn:Disconnect() conn = nil end
    if guardConn then guardConn:Disconnect() guardConn = nil end
    bindToken += 1
    local myToken = bindToken

    local Head     = char:WaitForChild("Head", 10)
    local RootPart = char:WaitForChild("HumanoidRootPart", 10)
    if not Head or not RootPart then return end
    if myToken ~= bindToken then return end

    local accessory, handle = findHat(char)
    for _ = 1, 100 do
        if accessory then break end
        task.wait(0.1)
        if myToken ~= bindToken then return end
        accessory, handle = findHat(char)
    end
    if not accessory then
        warn("[Aura] Khong tim thay '" .. HAT_NAME .. "' tren nhan vat!")
        return
    end

    -- doi engine hang xong weld goc roi moi go
    task.wait(0.3)
    if myToken ~= bindToken then return end
    accessory, handle = findHat(char)
    if not accessory then return end

    local weld = setupWeld(handle, Head)
    print("[Aura] Bat dau AURA voi '" .. HAT_NAME .. "' (V = bat/tat TP vao nguoi)")

    local lostTime = nil
    conn = RunService.Heartbeat:Connect(function()
        if LocalPlayer.Character ~= char or not Head.Parent or not RootPart.Parent then
            if conn then conn:Disconnect() conn = nil end
            return
        end

        -- hat / weld bi mat -> tim lai
        if not handle.Parent
           or not handle:IsDescendantOf(char)
           or not weld.Parent
           or weld.Part0 ~= Head then
            local now = os.clock()
            if not lostTime then lostTime = now end
            if now - lostTime > 0.25 then
                lostTime = nil
                local a, h = findHat(char)
                if a and h then
                    handle = h
                    weld = setupWeld(handle, Head)
                    print("[Aura] Ket noi lai voi '" .. HAT_NAME .. "'")
                end
            end
            return
        end
        lostTime = nil

        -- hat bay qua xa (bi fling / lag) -> snap ve dau
        if (handle.Position - RootPart.Position).Magnitude > MAX_DIST then
            weld.C0 = CFrame.new(0, 1.5, 0)
            return
        end

        local t     = os.clock()
        local angle = (t * SPEED) % TAU
        local spin  = (t * SPIN) % TAU
        local center = RootPart.Position + Vector3.new(0, HEIGHT, 0)

        local inBody = false
        if tpOn then
            inBody = (t % TP_INTERVAL) > (TP_INTERVAL - TP_STAY)
        end

        local pos
        if inBody then
            pos = RootPart.Position + TP_OFFSET
        else
            pos = center + Vector3.new(
                math.cos(angle) * RADIUS,
                math.sin(t * 2) * BOB,
                math.sin(angle) * RADIUS
            )
        end

        local desired = CFrame.new(pos) * CFrame.Angles(0, spin, 0)

        local ok = pcall(function()
            weld.C0 = Head.CFrame:Inverse() * desired * weld.C1
        end)
        if not ok then
            weld.C0 = CFrame.new(0, 1.5, 0)
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.spawn(bind, char)
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == TOGGLE_KEY then
        tpOn = not tpOn
        print("[Aura] TP vao nguoi: " .. (tpOn and "BAT" or "TAT"))
    end
end)

if LocalPlayer.Character then
    task.spawn(bind, LocalPlayer.Character)
end
wait(1)
